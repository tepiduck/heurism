# Public API endpoints are intentionally left blank in the scaffold.
# CLOB_HTTP_URL=
# CLOB_WS_URL=
# GAMMA_URL=

# Never commit a real wallet private key.
# WALLET_PRIVATE_KEY=

# Kalshi API credentials. Keep PEM files under secrets/ or another ignored path.
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=secrets/kalshi-api.key

MODE=paper
DATA_DIR=data

# Live mode is rejected unless LIVE=1 is set explicitly.
# LIVE=1
